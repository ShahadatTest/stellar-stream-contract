# Example environment for local runs. Copy to .env and never commit secrets.

# testnet | futurenet | mainnet
SENTINEL_NETWORK=testnet

# Optional: point at your own RPC
# SENTINEL_RPC_URL=https://soroban-testnet.stellar.org

# Deployed registry (see deployments.json)
SENTINEL_REGISTRY_ID=CC4TQFW5GLQTOKWTDE7IJWPQFWJ4NWVMJGBFWB76PUP3T7CEOVVSQW6O

# Only needed for registry writes
# SENTINEL_SECRET=S...

# Only needed for read-only simulation on mainnet, where there is no friendbot
# SENTINEL_PUBLIC_KEY=G...

# Default warn window in ledgers (518400 = 30 days at 5s)
SENTINEL_WARN_LEDGERS=518400
